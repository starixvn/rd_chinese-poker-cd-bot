FROM mcr.microsoft.com/dotnet/sdk:8.0 AS builder
WORKDIR /app

COPY ChinesePoker ./ChinesePoker
COPY CDBot ./CDBot
COPY ChinesePokerBot.sln ./
RUN dotnet restore
RUN dotnet publish -c Release -o out

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=builder /app/out .
CMD ["dotnet", "CDBot.dll", "--urls=http://0.0.0.0:5000"]